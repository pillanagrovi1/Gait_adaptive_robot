    "name": "pendulum"
  },
  "task_sweep": {
    "obs_mode": [
      "angle",
      "trig"
    ]
  },
  "run": {
    "episodes": 1500,
    "decay_episodes": 900,
    "eval_every": 50,
    "eval_episodes": 5
  },
  "seeds": [
    0,
    1,
    2,
    3,
    4
  ],
  "learners": [
    {
      "label": "table",
      "base": {
        "kind": "tabular",
        "alpha": 0.3,
        "gamma": 0.95,
        "bins": 11
      }
    },
    {
      "label": "linear",
      "base": {
        "kind": "linear",
        "alpha": 0.2,
        "gamma": 0.95,
        "tilings": 8,
        "tiles": 8,
        "features": 1024
      }
    },
    {
      "label": "net",
      "base": {
        "kind": "mlp",
        "alpha": 0.02,
        "gamma": 0.95,
        "hidden": 32,
        "td_clip": 1.0,
        "target_period": 100,
        "replay_cap": 2000,
        "batch": 8
      }
    },
    {
      "label": "random",
      "base": {
        "kind": "baseline_random"
      }
    },
    {
      "label": "zero-torque",
      "base": {
        "kind": "baseline_const",
        "action": 1
      }
    }
  ]
