{
  "name": "pendulum_main",
  "_note": "Stage 3: all three learners on the pendulum, each swept along its memory knob. Same gamma, same reward, same budget.",
  "task": {
    "name": "pendulum",
    "obs_mode": "angle"
  },
  "run": {
    "episodes": 1500,
    "decay_episodes": 900,
    "eval_every": 50,
    "eval_episodes": 5
  },
  "seeds": [
    0,
    1,
    2,
    3,
    4
  ],
  "metrics": {
    "threshold": -200
  },
  "learners": [
    {
      "label": "table",
      "base": {
        "kind": "tabular",
        "alpha": 0.3,
        "gamma": 0.95
      },
      "sweep": {
        "bins": [
          7,
          11,
          15,
          21,
          31
        ]
      }
    },
    {
      "label": "linear",
      "base": {
        "kind": "linear",
        "alpha": 0.2,
        "gamma": 0.95,
        "tilings": 8,
        "tiles": 8
      },
      "sweep": {
        "features": [
          64,
          256,
          1024,
          4096
        ]
      }
    },
    {
      "label": "net",
      "base": {
        "kind": "mlp",
        "alpha": 0.02,
        "gamma": 0.95,
        "td_clip": 1.0,
        "target_period": 100,
        "replay_cap": 2000,
        "batch": 8
      },
      "sweep": {
        "hidden": [
          8,
          16,
          32,
          64
        ]
      },
      "task": {
        "obs_mode": "trig"
      }
    },
    {
      "label": "random",
      "base": {
        "kind": "baseline_random"
      }
    },
    {
      "label": "zero-torque",
      "base": {
        "kind": "baseline_const",
        "action": 1
      }
    }
  ]
}